# 鱼塘 agent 智能体配置示例 —— 复制为 .env 后按需修改
# 注意: .env 含密钥, 不要提交到 git / 不要外传

# —— 鱼塘(Xechat) 连接 ——
XE_HOST=101.42.19.160
XE_PORT=33859
# 代理: 0 = 直连。预发会快速封禁新登录 IP, 长期挂机建议走稳定代理出口
PROXY_HOST=127.0.0.1
PROXY_PORT=7897

# —— 身份 ——
# 大众版登录名: 小黄鱼; 领养后的专属实例登录名为 <领养人>的小黄鱼 (自动)
BOT_USERNAME=小黄鱼
BOT_STATUS=FISHING

# —— 领养/专属模式 (由主 agent 拉起独立进程时自动注入, 一般不用手动配) ——
# OWNER=牛来少年
# OWNER_PREFIX=/牛来少年的小黄鱼

# —— 指令 ——
CMD_PREFIX=/小黄鱼

# —— @ 提及聊天 (收到 "@小黄鱼 …" 也响应, 但只聊天: 不触发命令/工具/应用查询) ——
# DISABLE_MENTION=0           # =1 关闭 @ 聊天
# MENTION_CHAT_PREFIX=chat:   # @ 聊天独立上下文 key 前缀(与命令上下文隔离)

# —— 思考过程输出到鱼塘聊天 ——
# 默认开启: agent 调用工具后会把「工具查询结果」(带 💭 前缀) 发到聊天里, 再发正式回答。
# 注意: 只发结果, 不发"正在思考"之类的过程占位。
# HIDE_THINKING=1  # 关闭思考结果展示
# THINKING_PREFIX=💭

# —— Xechat 平台 API (游戏/排行榜/服务器/上传) ——
# 客户端 API 基址 (实际可用前缀是 /api/, 非 api-docs 里写的 /xeManager)
# XE_API_BASE=https://dld.lesscoding.net
# XE_API_TIMEOUT_MS=12000

# —— 上传/鉴权 (upload_image 工具): 登录拿 token, 再 multipart 上传到 /api/file/upload ——
# XECHAT_API_USERNAME=123456
# XECHAT_API_PASSWORD=your_password
# XE_API_AUTH_PATH=/api/user/login
# XE_API_UPLOAD_PATH=/api/file/upload
# XE_API_MAX_UPLOAD_BYTES=52428800   # 单文件上限(默认 50MB)

# —— LLM (DeepSeek) ——
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE=https://api.deepseek.com
# LLM_TIMEOUT_MS=20000
# LLM_MAX_TOKENS=300

# —— 行为(默认值即可, 一般不用改) ——
# HEARTBEAT_MS=25000
# STALE_TIMEOUT_MS=90000
# REPLY_COOLDOWN_MS=4000
# REPLAY_SKIP_MS=2000
# HISTORY_MAX=10
# 单条聊天消息上限 200 字符(服务端实测, 201 即被丢弃); 超长回复自动分片多段发送
# MSG_MAX_LEN=200
# MSG_CHUNK_DELAY_MS=300

# —— 上下文压缩 (结构化, 参考 opencode: token预算 + 旧消息结构化摘要) ——
# COMPRESS_AT=14    # 兼容字段(旧触发阈值, 仍保留)
# SUMMARY_MAX_LEN=800
# COMPACTION_TOKEN_BUDGET=3000   # 会话估计 token 达该值触发压缩(保留最近预算内消息)

# —— 多智能体 (参考 opencode agent 定义) ——
# SUBAGENT_DEPTH=1              # 子智能体最大嵌套深度 (delegate 工具防递归)
# SUBAGENT_ITERATIONS=6         # 子智能体单次最大工具调用步数

# —— 待办 (todo 工具/指令) ——
# TODO_MAX=20                   # 每会话最大待办条数

# —— 技能包 (skill 工具: report/explain/analyze/translate/story/task) ——
# DISABLE_SKILLS=0

# —— 持久记忆 (remember/recall 工具; 聊天室消息非真私密, 默认关) ——
# ENABLE_MEMORY=0               # =1 开启向 data/memory.json 记录用户事实
# MEMORY_FILE=data/memory.json
# MEMORY_MAX_FACTS=30

# —— 定时任务 (schedule 工具 / /小黄鱼 定时) ——
# DISABLE_SCHEDULE=0            # =1 关闭定时任务
# SCHEDULE_TICK_MS=5000         # 到期检查间隔
# ENABLE_SCHEDULE_PERSIST=0     # =1 落盘到 data/schedule.json, 重启恢复
# SCHEDULE_FILE=data/schedule.json

# —— 当前会话聊天记录 (recent_messages 工具 / /小黄鱼 最近消息) ——
# ROOM_LOG_MAX=100              # 环形上限, 只记连接后收到的消息, 不回溯历史(内存)

# —— 聊天记录日志 (chat_log 工具 / /小黄鱼 聊天记录; JSONL 落盘, 跨重启可查) ——
# DISABLE_CHAT_LOG=0            # =1 关闭落盘
# CHAT_LOG_FILE=data/chat-log.jsonl
# CHAT_LOG_MAX=1000             # 保留上限(超限裁剪最近)

# —— 主动消息触发器 (默认关, 有刷屏风险需显式开启) ——
# ENABLE_TRIGGER=0              # =1 开启: 每累计 N 条(非自己)消息→agent 主动发一条争议性广播
# TRIGGER_THRESHOLD=10          # 每累计 N 条消息触发一次
# TRIGGER_COOLDOWN_MS=300000    # 触发后冷却(毫秒), 防刷屏

# —— 文件分享 (sendup.cc 三步上传, send_file 工具 / /小黄鱼 发送文件) ——
# DISABLE_SENDUP=0              # =1 关闭文件分享
# SENDUP_TIMEOUT_MS=90000       # 单次上传总超时(大文件需调高)
# SENDUP_MAX_BYTES=52428800     # 文件大小上限(默认 50MB)

# —— Python 执行工具 ——
# PYTHON_CMD=python
# PYTHON_TIMEOUT_MS=15000

# —— MiniMax 图片生成 (generate_image 工具, 文生图 / 图生图) ——
# 参考 H:\Documents\software-dev-ai-workflow\0.0-通用skill\docs-minimax-docs\图片生成.md
# 留空即工具不可用 (调用会返回明确错误, 不会误用其它 key)
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_BASE=https://api.minimaxi.com
# MINIMAX_IMAGE_TIMEOUT_MS=120000

# —— 联网工具 (web_search / fetch_url / gold_price, 走代理) ——
# DISABLE_WEB=0
# WEB_TIMEOUT_MS=15000

# —— 领养功能 (主 agent 拉起专属实例) ——
# DISABLE_ADOPT=0

# —— 离线自测: MOCK_LLM=1 时不调真实 API ——
# MOCK_LLM=0
